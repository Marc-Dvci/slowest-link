CREATE (n0:Service {description: "Envoy front door that routes every web request to the frontend, images and feature flags.", name: "frontend-proxy", owner: "Platform", recovery_min: 15}),
       (n1:Service {description: "Quote service that computes shipping cost quotes.", name: "quote", owner: "Orders", recovery_min: 30}),
       (n2:Service {description: "Email service that sends the order confirmation.", name: "email", owner: "Orders", recovery_min: 60}),
       (n3:Service {description: "Recommendation service that suggests related products.", name: "recommendation", owner: "Marketing", recovery_min: 60}),
       (n4:Service {description: "Ad service that serves contextual ads.", name: "ad", owner: "Marketing", recovery_min: 60}),
       (n5:Service {description: "nginx server for the product images.", name: "image-provider", owner: "Platform", recovery_min: 30}),
       (n6:Service {description: "flagd feature flag service that evaluates flags for every service.", name: "flagd", owner: "Platform", recovery_min: 15}),
       (n7:Service {description: "Web console for editing feature flags.", name: "flagd-ui", owner: "Platform", recovery_min: 60}),
       (n8:Queue {description: "Kafka message queue that carries placed orders to accounting and fraud detection.", name: "kafka", owner: "Platform", recovery_min: 120}),
       (n9:Datastore {description: "PostgreSQL database that holds the product catalogue and the accounting ledger.", name: "astronomy-db", owner: "Platform", recovery_min: 240}),
       (n10:Service {description: "Accounting service that records each placed order in the ledger.", name: "accounting", owner: "Finance", recovery_min: 120}),
       (n11:Service {description: "Next.js web frontend that renders the shop pages and serves its API routes.", name: "frontend", owner: "Storefront", recovery_min: 15}),
       (n12:Service {description: "Fraud detection service that screens each placed order.", name: "fraud-detection", owner: "Risk", recovery_min: 120}),
