# Copy to .env and fill in. Never commit .env. These are every variable the code reads.
# Only the agent evaluation (experiments/agent_eval.py) calls a model; everything else needs no key.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# The Relate CLI sends anonymous usage counts unless this is set.
DO_NOT_TRACK=1
