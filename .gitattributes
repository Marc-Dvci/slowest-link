# Text files are stored with LF line endings, whatever machine they were saved on.
* text=auto eol=lf
*.sh text eol=lf

# Relate's own files for the vault: kept byte for byte.
plan/.relate/** -text

# Binary data.
*.png binary
*.jpg binary
*.gif binary
*.gz binary

# Keep the languages bar honest: generated data does not count as code.
web/data/** linguist-generated
evidence/** linguist-generated
