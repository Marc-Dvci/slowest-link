{
  "name": "Slowest Link",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "containerEnv": { "DO_NOT_TRACK": "1" },
  "postCreateCommand": "pip install -r requirements.txt && python -m slowest_link check",
  "postStartCommand": "nohup bash -c 'python -m http.server 8080 --directory web > /tmp/web.log 2>&1 &'",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Slowest Link page",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
